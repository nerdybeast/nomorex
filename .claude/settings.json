{
  "permissions": {
    "deny": [
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(supabase * --linked*)",
      "Bash(supabase * --db-url*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "dart"
  ]
}
